{
  "name": "writer-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地优先的 AI 网文写作工作台（Chrome MV3 扩展）：书架与章节管理、段落排版、伏笔标注、本地 RAG 文风画像、Agent 自主写作（人在环），自带模型密钥。",
  "license": "MIT",
  "keywords": ["chrome-extension", "manifest-v3", "writing", "novel", "rag", "bm25", "llm", "agent", "local-first", "indexeddb"],
  "engines": { "node": ">=18" },
  "scripts": {
    "check": "node tools/check.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "ci": "npm run check && npm run lint && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "eslint": "^9.13.0"
  }
}
