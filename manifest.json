{
  "manifest_version": 3,
  "name": "码字工坊 · Writer Studio",
  "version": "0.1.1",
  "description": "本地优先的网文创作工作台：作品/章节管理、字数统计、快照历史，可选外部 AI 辅助（自带密钥）。",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "码字工坊",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "app/index.html" },
  "options_page": "app/index.html",
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "downloads", "clipboardWrite"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.moonshot.cn/*",
    "https://api.siliconflow.cn/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*"]
}
